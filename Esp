local function serialize()
	return HttpService:JSONEncode({
		Aimbot = {
			Enabled = CFG.Aimbot.Enabled,
			Mode = CFG.Aimbot.Mode,
			Key = CFG.Aimbot.Key.Name,
			FOV = CFG.Aimbot.FOV,
			Smooth = CFG.Aimbot.Smooth,
			Part = CFG.Aimbot.Part,
			MaxDist = CFG.Aimbot.MaxDist,
			Prediction = CFG.Aimbot.Prediction,
			TeamCheck = CFG.Aimbot.TeamCheck,
			WallCheck = CFG.Aimbot.WallCheck,
			ShowFOV = CFG.Aimbot.ShowFOV,
		},
		ESP = {
			Enabled = CFG.ESP.Enabled,
			Box = CFG.ESP.Box,
			Name = CFG.ESP.Name,
			Distance = CFG.ESP.Distance,
			Health = CFG.ESP.Health,
			Tracer = CFG.ESP.Tracer,
			TeamCheck = CFG.ESP.TeamCheck,
			MaxDist = CFG.ESP.MaxDist,
			Color = { CFG.ESP.Color.R, CFG.ESP.Color.G, CFG.ESP.Color.B },
		},
		Menu = { Key = CFG.Menu.Key.Name },
	})
end

local function saveConfig()
	local ok, encoded = pcall(serialize)
	if not ok then
		return
	end
	if writefile then
		pcall(writefile, CONFIG_FILE, encoded)
	end
end

local function loadConfig()
	if not (isfile and readfile) then
		return
	end
	local ok, exists = pcall(isfile, CONFIG_FILE)
	if not ok or not exists then
		return
	end

	local readOk, raw = pcall(readfile, CONFIG_FILE)
	if not readOk or not raw then
		return
	end

	local decodeOk, data = pcall(HttpService.JSONDecode, HttpService, raw)
	if not decodeOk or type(data) ~= "table" then
		return
	end

	local function key(name: string): Enum.KeyCode?
		local found = Enum.KeyCode[name]
		return if found then found else nil
	end

	if type(data.Aimbot) == "table" then
		for field, value in pairs(data.Aimbot) do
			if field == "Key" then
				local k = key(value)
				if k then
					CFG.Aimbot.Key = k
				end
			elseif CFG.Aimbot[field] ~= nil then
				CFG.Aimbot[field] = value
			end
		end
	end

	if type(data.ESP) == "table" then
		for field, value in pairs(data.ESP) do
			if field == "Color" and type(value) == "table" then
				CFG.ESP.Color = Color3.new(value[1], value[2], value[3])
			elseif CFG.ESP[field] ~= nil then
				CFG.ESP[field] = value
			end
		end
	end

	if type(data.Menu) == "table" and data.Menu.Key then
		local k = key(data.Menu.Key)
		if k then
			CFG.Menu.Key = k
		end
	end
end

