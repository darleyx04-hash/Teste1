--==========================================
-- LOOP PRINCIPAL
--==========================================
local function MainLoop()
    -- Verificar teclas
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        
        if input.KeyCode == Config.Teclas.Menu then
            MenuSystem.Alternar()
        elseif input.KeyCode == Config.Teclas.Esquentar then
            Aquecimento.Iniciar()
        elseif input.KeyCode == Config.Teclas.Panico then
            print("[CUE7A] MODO PÂNICO ATIVADO - Desativando tudo...")
            Estado.Aimbot.Ativo = false
            Estado.ESP.Ativo = false
            if MenuSystem.GUI then
                local mainFrame = MenuSystem.GUI:FindFirstChild("MainFrame")
                if mainFrame then mainFrame.Visible = false end
            end
        end
    end)
    
    -- Atualizar aquecimento
    task.spawn(function()
        while true do
            task.wait(1)
            Aquecimento.Atualizar()
        end
    end)
    
    -- Renderização por frame
    RunService.RenderStepped:Connect(function()
        -- Atualizar ESP
        if Estado.ESP.Ativo and Estado.Esquentado then
            ESPSystem.Renderizar()
        end
    end)
    
    -- Aimbot
    RunService.Heartbeat:Connect(function()
        if Estado.Aimbot.Ativo and Estado.Esquentado then
            if UserInputService:IsMouseButtonPressed(Config.Teclas.Aimbot) then
                AimbotSystem.AplicarAimbot()
            end
        end
    end)
end

--==========================================
-- EXECUÇÃO PRINCIPAL
--==========================================
task.spawn(function()
    if not IniciarSistema() then
        print("[CUE7A] Falha na inicialização. Sistema encerrado.")
        return
    end
    
    MainLoop()
end)

