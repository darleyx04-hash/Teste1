-- ESP
local function createESP(target)
    if target == player then return end

    local function applyCharacter(character)
        if highlights[target] then
            highlights[target]:Destroy()
        end

        local highlight = Instance.new("Highlight")
        highlight.Name = "RedESP"
        highlight.Adornee = character
        highlight.FillTransparency = 1
        highlight.OutlineTransparency = 0
        highlight.OutlineColor = ESP_COLOR
        highlight.DepthMode =
            Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Enabled = ESP_ENABLED
        highlight.Parent = character

        highlights[target] = highlight
    end

    if target.Character then
        applyCharacter(target.Character)
    end

    target.CharacterAdded:Connect(applyCharacter)
end

for _, target in ipairs(Players:GetPlayers()) do
    createESP(target)
end

Players.PlayerAdded:Connect(createESP)

Players.PlayerRemoving:Connect(function(target)
    if highlights[target] then
        highlights[target]:Destroy()
        highlights[target] = nil
    end
end)

-- NPCs de treinamento
local function getClosestNPC()
    local folder = Workspace:FindFirstChild("TrainingNPCs")
    if not folder then return nil end

    local closest = nil
    local shortestDistance = FOV_RADIUS
    local center = camera.ViewportSize / 2

    for _, npc in ipairs(folder:GetChildren()) do
        local humanoid = npc:FindFirstChildOfClass("Humanoid")
        local head = npc:FindFirstChild("Head")

        if humanoid and head and humanoid.Health > 0 then
            local position, visible =
                camera:WorldToViewportPoint(head.Position)

            if visible then
                local distance = (
                    Vector2.new(position.X, position.Y) - center
                ).Magnitude

                if distance < shortestDistance then
                    shortestDistance = distance
                    closest = head
                end
            end
        end
    end

    return closest
end

