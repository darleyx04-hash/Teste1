local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local gui = Instance.new("ScreenGui")
gui.Name = "DarkBlueMenu"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local BLUE = Color3.fromRGB(0, 110, 255)
local DARK = Color3.fromRGB(12, 14, 20)
local PANEL = Color3.fromRGB(25, 29, 38)
local WHITE = Color3.fromRGB(255, 255, 255)

local main = Instance.new("Frame")
main.Size = UDim2.fromOffset(340, 400)
main.Position = UDim2.new(.5, -170, .5, -200)
main.BackgroundColor3 = DARK
main.BorderSizePixel = 0
main.Parent = gui

Instance.new("UICorner", main).CornerRadius = UDim.new(0, 10)

local outline = Instance.new("UIStroke")
outline.Color = BLUE
outline.Thickness = 1.5
outline.Parent = main

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -90, 0, 45)
title.Position = UDim2.fromOffset(12, 0)
title.BackgroundTransparency = 1
title.Text = "DARK BLUE | CONTROL"
title.TextColor3 = WHITE
title.Font = Enum.Font.GothamBold
title.TextSize = 15
title.TextXAlignment = Enum.TextXAlignment.Left
title.Parent = main

local minimize = Instance.new("TextButton")
minimize.Size = UDim2.fromOffset(35, 30)
minimize.Position = UDim2.new(1, -45, 0, 8)
minimize.Text = "-"
minimize.BackgroundColor3 = BLUE
minimize.TextColor3 = WHITE
minimize.Parent = main

local content = Instance.new("Frame")
content.Position = UDim2.fromOffset(10, 52)
content.Size = UDim2.new(1, -20, 1, -62)
content.BackgroundTransparency = 1
content.Parent = main

local minimized = false

minimize.MouseButton1Click:Connect(function()
    minimized = not minimized
    content.Visible = not minimized
    main.Size = minimized
        and UDim2.fromOffset(340, 45)
        or UDim2.fromOffset(340, 400)
    minimize.Text = minimized and "+" or "-"
end)

-- DRAG
local dragging = false
local dragStart, startPosition

title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPosition = main.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

-- TAB SYSTEM
local tabs = {"AIM", "ESP", "SECURITY"}
local pages = {}
local activePage

local tabBar = Instance.new("Frame")
tabBar.Size = UDim2.new(1, 0, 0, 35)
tabBar.BackgroundTransparency = 1
tabBar.Parent = content

local pageArea = Instance.new("Frame")
pageArea.Position = UDim2.fromOffset(0, 42)
pageArea.Size = UDim2.new(1, 0, 1, -42)
pageArea.BackgroundTransparency = 1
pageArea.Parent = content

for i, tab in ipairs(tabs) do
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1/3, -4, 1, 0)
    button.Position = UDim2.new((i-1)/3, 0, 0, 0)
    button.Text = tab
    button.Font = Enum.Font.GothamBold
    button.TextSize = 12
    button.TextColor3 = WHITE
    button.BackgroundColor3 = PANEL
    button.Parent = tabBar

    local page = Instance.new("Frame")
    page.Size = UDim2.fromScale(1, 1)
    page.BackgroundTransparency = 1
    page.Visible = false
    page.Parent = pageArea
    pages[tab] = page

    button.MouseButton1Click:Connect(function()
        for _, p in pairs(pages) do
            p.Visible = false
        end
        page.Visible = true
        activePage = tab
    end)
end

pages.AIM.Visible = true

local function addToggle(page, name, callback)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, 0, 0, 38)
    button.BackgroundColor3 = PANEL
    button.TextColor3 = WHITE
    button.Font = Enum.Font.Gotham
    button.TextSize = 13
    button.Parent = page

    local layout = page:FindFirstChildOfClass("UIListLayout")
    if not layout then
        layout = Instance.new("UIListLayout")
        layout.Padding = UDim.new(0, 8)
        layout.Parent = page
    end

    local enabled = false

    local function refresh()
        button.Text = name .. "  [" ..
            (enabled and "ON" or "OFF") .. "]"
        button.BackgroundColor3 = enabled and BLUE or PANEL
    end

    button.MouseButton1Click:Connect(function()
        enabled = not enabled
        refresh()
        if callback then callback(enabled) end
    end)

    refresh()
end

addToggle(pages.AIM, "Aim Assist")
addToggle(pages.ESP, "ESP Box")
addToggle(pages.ESP, "ESP Line")
addToggle(pages.ESP, "Head Marker")

-- SECURITY MONITORING
local securityLabel = Instance.new("TextLabel")
securityLabel.Size = UDim2.new(1, 0, 0, 55)
securityLabel.BackgroundColor3 = PANEL
securityLabel.TextColor3 = WHITE
securityLabel.TextWrapped = true
securityLabel.Font = Enum.Font.Gotham
securityLabel.TextSize = 12
securityLabel.Text = "SECURITY MONITORING\nClient interface active"
securityLabel.Parent = pages.SECURITY

addToggle(pages.SECURITY, "Security Monitor", function(enabled)
    securityLabel.Text = enabled
        and "SECURITY MONITORING\nMonitoring enabled"
        or "SECURITY MONITORING\nMonitoring paused"
end)

