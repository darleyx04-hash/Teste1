-- ==========================================
-- MATH & UTILS
-- ==========================================
local Vec3 = {}
Vec3.__index = Vec3

function Vec3.new(x, y, z)
    return setmetatable({x=x or 0, y=y or 0, z=z or 0}, Vec3)
end

function Vec3:__add(other) return Vec3.new(self.x + other.x, self.y + other.y, self.z + other.z) end
function Vec3:__sub(other) return Vec3.new(self.x - other.x, self.y - other.y, self.z - other.z) end
function Vec3:__mul(scalar) return Vec3.new(self.x * scalar, self.y * scalar, self.z * scalar) end
function Vec3:magnitude() return math.sqrt(self.x^2 + self.y^2 + self.z^2) end
function Vec3:normalized()
    local mag = self:magnitude()
    if mag == 0 then return Vec3.new(0,0,0) end
    return Vec3.new(self.x/mag, self.y/mag, self.z/mag)
end
function Vec3:dot(other) return self.x*other.x + self.y*other.y + self.z*other.z end
function Vec3:distance(other) return (self - other):magnitude() end

-- Seeded Random (LCG) for consistent human patterns
local rng_state = CONFIG.stealth.randomSeed
local function seededRandom()
    rng_state = (rng_state * 1103515245 + 12345) & 0x7FFFFFFF
    return rng_state / 0x7FFFFFFF
end

local function noise(x, y, z)
    -- Simple 3D noise approximation for smooth human movement
    local n = seededRandom() * 0.5 + (x * 0.1 + y * 0.1 + z * 0.1) * 0.1
    return n - 0.5
end

-- ==========================================
-- STEALTH CORE (ANTI-BAN LOGIC)
-- ==========================================
local Stealth = {}

-- Humanize a value by adding controlled noise
function Stealth.Humanize(value, intensity, axis)
    if not CONFIG.stealth.enabled or not CONFIG.stealth.humanizeRotation then
        return value
    end
    
    -- Perlin-like noise based on time to create smooth, non-linear movement
    local t = os.clock()
    local smoothNoise = math.sin(t * CONFIG.stealth.jitterFrequency * 10) * 
                        math.cos(t * CONFIG.stealth.jitterFrequency * 7 + (axis or 0))
    
    -- Add random jitter
    local randomJitter = (seededRandom() - 0.5) * 2 * CONFIG.stealth.jitterAmount
    
    -- Combine
    local humanizedValue = value + (smoothNoise * intensity) + randomJitter
    
    -- Clamp to reasonable values
    if axis == "yaw" then
        humanizedValue = humanizedValue % (2 * math.pi)
    else
        humanizedValue = math.max(-math.pi/2, math.min(math.pi/2, humanizedValue))
    end
    
    return humanizedValue
end

-- Dynamic FOV Drift
function Stealth.GetDynamicFOV(baseFov)
    if not CONFIG.stealth.dynamicFovDrift then return baseFov end
    local t = os.clock()
    -- Slow sine wave drift (+/- 2 degrees)
    local drift = math.sin(t * 0.5) * 2.0
    return baseFov + drift
end

-- Randomize Tick Rate
function Stealth.GetCurrentTick()
    if not CONFIG.stealth.tickRandomization then
        return CONFIG.stealth.baseTickRate
    end
    local variance = (seededRandom() - 0.5) * 2 * CONFIG.stealth.tickVariance
    return CONFIG.stealth.baseTickRate + variance
end

-- Memory Read Obfuscation (Simulated)
-- In a real environment, you would XOR the data before/after reading 
-- to prevent pattern matching by anti-cheat memory scanners.
function Stealth.ObfuscateData(data)
    if not CONFIG.stealth.memoryObfuscation then return data end
    -- Simple XOR with a rotating key
    local key = os.time() % 256
    -- For numbers, we apply a simple transformation
    -- In a real C# bridge, this would be applied to the byte stream
    return data * (1 + (key / 10000)) -- Simulated obfuscation
end

