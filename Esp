function Widget.Toggle(parent: Instance, label: string, initial: boolean, callback: (boolean) -> ())
	local holder = make("Frame", {
		Size = UDim2.new(1, -16, 0, 30),
		Position = UDim2.new(0, 8, 0, 4),
		BackgroundColor3 = Theme.Row,
		Parent = parent,
	})
	round(holder, 6)

	make("TextLabel", {
		Size = UDim2.new(1, -50, 1, 0),
		Position = UDim2.new(0, 10, 0, 0),
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		Text = label,
		TextSize = 12,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = holder,
	})

	local track = make("Frame", {
		Size = UDim2.fromOffset(34, 18),
		Position = UDim2.new(1, -42, 0.5, -9),
		BackgroundColor3 = Theme.Stroke,
		Parent = holder,
	})
	round(track, 9)

	local knob = make("Frame", {
		Size = UDim2.fromOffset(14, 14),
		Position = UDim2.new(0, 2, 0.5, -7),
		BackgroundColor3 = Theme.Text,
		Parent = track,
	})
	round(knob, 7)

	local state = initial

	local function render(animate: boolean)
		local tween = TweenInfo.new(0.15, Enum.EasingStyle.Quad)
		if animate then
			TweenService:Create(knob, tween, {
				Position = if state then UDim2.new(1, -16, 0.5, -7) else UDim2.new(0, 2, 0.5, -7),
			}):Play()
			TweenService:Create(track, tween, {
				BackgroundColor3 = if state then Theme.Accent else Theme.Stroke,
			}):Play()
		else
			knob.Position = if state then UDim2.new(1, -16, 0.5, -7) else UDim2.new(0, 2, 0.5, -7)
			track.BackgroundColor3 = if state then Theme.Accent else Theme.Stroke
		end
	end

	render(false)

	holder.InputBegan:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			state = not state
			render(true)
			callback(state)
		end
	end)

	return holder
end

function Widget.Slider(parent: Instance, label: string, min: number, max: number, initial: number, decimals: number, callback: (number) -> ())
	local holder = make("Frame", {
		Size = UDim2.new(1, -16, 0, 46),
		Position = UDim2.new(0, 8, 0, 4),
		BackgroundColor3 = Theme.Row,
		Parent = parent,
	})
	round(holder, 6)

	make("TextLabel", {
		Size = UDim2.new(1, -60, 0, 18),
		Position = UDim2.new(0, 10, 0, 5),
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		Text = label,
		TextSize = 12,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = holder,
	})

	local valueLabel = make("TextLabel", {
		Size = UDim2.fromOffset(50, 18),
		Position = UDim2.new(1, -60, 0, 5),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = tostring(initial),
		TextSize = 12,
		TextColor3 = Theme.Accent,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = holder,
	})

	local bar = make("Frame", {
		Size = UDim2.new(1, -20, 0, 5),
		Position = UDim2.new(0, 10, 0, 32),
		BackgroundColor3 = Theme.Stroke,
		Parent = holder,
		Active = true,
	})
	round(bar, 3)

	local fill = make("Frame", {
		Size = UDim2.fromScale((initial - min) / (max - min), 1),
		BackgroundColor3 = Theme.Accent,
		Parent = bar,
	})
	round(fill, 3)

	local value = initial
	local dragging = false

	local function apply(v: number)
		value = math.clamp(v, min, max)
		local step = 10 ^ decimals
		value = math.round(value * step) / step
		fill.Size = UDim2.fromScale((value - min) / (max - min), 1)
		valueLabel.Text = tostring(value)
		callback(value)
	end

	local function fromX(x: number)
		local origin = bar.AbsolutePosition.X
		local width = bar.AbsoluteSize.X
		if width <= 0 then
			return
		end
		apply(min + math.clamp((x - origin) / width, 0, 1) * (max - min))
	end

	bar.InputBegan:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			fromX(input.Position.X)
		end
	end)

	local conn = UserInputService.InputChanged:Connect(function(input: InputObject)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			fromX(input.Position.X)
		end
	end)

	UserInputService.InputEnded:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)

	return holder
end

function Widget.Dropdown(parent: Instance, label: string, options: {string}, initial: string, callback: (string) -> ())
	local holder = make("Frame", {
		Size = UDim2.new(1, -16, 0, 30),
		Position = UDim2.new(0, 8, 0, 4),
		BackgroundColor3 = Theme.Row,
		Parent = parent,
	})
	round(holder, 6)

	make("TextLabel", {
		Size = UDim2.new(1, -110, 1, 0),
		Position = UDim2.new(0, 10, 0, 0),
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		Text = label,
		TextSize = 12,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = holder,
	})

	local btn = make("TextButton", {
		Size = UDim2.fromOffset(90, 20),
		Position = UDim2.new(1, -98, 0.5, -10),
		BackgroundColor3 = Theme.Panel,
		Font = Enum.Font.GothamBold,
		Text = initial,
		TextSize = 11,
		TextColor3 = Theme.Accent,
		AutoButtonColor = false,
		Parent = holder,
	})
	round(btn, 5)
	stroke(btn, Theme.Stroke, 1)

	local list = make("Frame", {
		Size = UDim2.new(1, -16, 0, #options * 22 + 4),
		Position = UDim2.new(0, 8, 0, 0),
		BackgroundColor3 = Theme.Panel,
		Visible = false,
		Parent = parent,
	})
	round(list, 6)
	stroke(list, Theme.Stroke, 1)

	local current = initial

	for index, option in ipairs(options) do
		local opt = make("TextButton", {
			Size = UDim2.new(1, -8, 0, 20),
			Position = UDim2.new(0, 4, 0, 2 + (index - 1) * 22),
			BackgroundTransparency = 1,
			Font = Enum.Font.Gotham,
			Text = option,
			TextSize = 11,
			TextColor3 = Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = list,
		})
		opt.MouseEnter:Connect(function()
			opt.TextColor3 = Theme.Accent
		end)
		opt.MouseLeave:Connect(function()
			opt.TextColor3 = Theme.Text
		end)
		opt.MouseButton1Click:Connect(function()
			current = option
			btn.Text = option
			list.Visible = false
			callback(option)
		end)
	end

	btn.MouseButton1Click:Connect(function()
		list.Visible = not list.Visible
	end)

	return holder
end

function Widget.Keybind(parent: Instance, label: string, initial: Enum.KeyCode, callback: (Enum.KeyCode) -> ())
	local holder = make("Frame", {
		Size = UDim2.new(1, -16, 0, 30),
		Position = UDim2.new(0, 8, 0, 4),
		BackgroundColor3 = Theme.Row,
		Parent = parent,
	})
	round(holder, 6)

	make("TextLabel", {
		Size = UDim2.new(1, -110, 1, 0),
		Position = UDim2.new(0, 10, 0, 0),
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		Text = label,
		TextSize = 12,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = holder,
	})

	local btn = make("TextButton", {
		Size = UDim2.fromOffset(90, 20),
		Position = UDim2.new(1, -98, 0.5, -10),
		BackgroundColor3 = Theme.Panel,
		Font = Enum.Font.GothamBold,
		Text = initial.Name,
		TextSize = 11,
		TextColor3 = Theme.Accent,
		AutoButtonColor = false,
		Parent = holder,
	})
	round(btn, 5)
	stroke(btn, Theme.Stroke, 1)

	local listening = false

	btn.MouseButton1Click:Connect(function()
		listening = true
		bindingNow = true
		btn.Text = "..."
	end)

	local conn = UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if not listening or processed then
			return
		end
		if input.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end
		listening = false
		bindingNow = false
		btn.Text = input.KeyCode.Name
		callback(input.KeyCode)
	end)

	return holder
end

