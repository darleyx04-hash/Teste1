local function make(cls: string, props: {[string]: any}, parent: Instance?): any
	local inst = Instance.new(cls)
	for k, v in pairs(props) do
		if k ~= "Parent" then
			(inst :: any)[k] = v
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function round(inst: GuiObject, r: number)
	make("UICorner", { CornerRadius = UDim.new(0, r) }, inst)
end

local function stroke(inst: GuiObject, color: Color3, thickness: number)
	local s = make("UIStroke", { Color = color, Thickness = thickness, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, inst)
	return s
end

local function getGuiParent(): Instance
	if G.gethui then
		local ok, res = pcall(G.gethui)
		if ok and typeof(res) == "Instance" then
			return res
		end
	end
	local ok, res = pcall(function()
		return LP:FindFirstChildOfClass("PlayerGui")
	end)
	if ok and res then
		return res
	end
	return game:GetService("CoreGui")
end

