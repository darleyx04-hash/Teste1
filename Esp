local function createPage(name: string): ScrollingFrame
	local page = make("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Stroke,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Visible = false,
		Parent = pages,
	})
	pageHolder[name] = page
	return page
end

local function switchTab(name: string)
	currentTab = name
	for tabName, page in pairs(pageHolder) do
		page.Visible = tabName == name
	end
	for tabName, btn in pairs(tabButtons) do
		btn.TextColor3 = if tabName == name then Theme.Accent else Theme.Muted
		btn.BackgroundColor3 = if tabName == name then Theme.Row else Theme.Panel
	end
end

