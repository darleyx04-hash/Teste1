--============================================================
-- ESP
--============================================================
local espCache: {[Player]: any} = {}

local function newDraw(kind: string, props: {[string]: any}): any
	local d = DrawingLib.new(kind)
	for k, v in pairs(props) do
		pcall(function()
			d[k] = v
		end)
	end
	return d
end

local function createESP(plr: Player)
	if espCache[plr] or not DrawingLib then
		return
	end

	espCache[plr] = {
		Box = newDraw("Square", { Thickness = 1, Filled = false, Color = CFG.ESP.Color, Transparency = 1, Visible = false }),
		Outline = newDraw("Square", { Thickness = 3, Filled = false, Color = Color3.new(), Transparency = 0.7, Visible = false }),
		Name = newDraw("Text", { Size = 13, Center = true, Outline = true, OutlineColor = Color3.new(), Font = FONT, Color = Color3.new(1, 1, 1), Visible = false }),
		Dist = newDraw("Text", { Size = 12, Center = true, Outline = true, OutlineColor = Color3.new(), Font = FONT, Color = Theme.Accent, Visible = false }),
		HealthBg = newDraw("Square", { Filled = true, Color = Color3.new(), Transparency = 0.6, Visible = false }),
		Health = newDraw("Square", { Filled = true, Color = Color3.fromRGB(0, 255, 90), Transparency = 0.2, Visible = false }),
		Tracer = newDraw("Line", { Thickness = 1, Color = CFG.ESP.Color, Transparency = 0.4, Visible = false }),
	}
end

local function removeESP(plr: Player)
	local o = espCache[plr]
	if not o then
		return
	end
	for _, d in pairs(o) do
		pcall(function()
			d:Remove()
		end)
	end
	espCache[plr] = nil
end

local function espTarget(plr: Player): (Model?, Humanoid?)
	if plr == LP then
		return nil, nil
	end

	local char = plr.Character
	if not char then
		return nil, nil
	end

	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then
		return nil, nil
	end

	if CFG.ESP.TeamCheck and LP.Team and plr.Team == LP.Team then
		return nil, nil
	end

	return char, hum
end

local function hideAll(o: any)
	for _, d in pairs(o) do
		pcall(function()
			d.Visible = false
		end)
	end
end

local function updateESP()
	local vp = Camera.ViewportSize
	local bottom = Vector2.new(vp.X / 2, vp.Y)

	for plr, o in pairs(espCache) do
		local char, hum = espTarget(plr)

		if not CFG.ESP.Enabled or not char or not hum then
			hideAll(o)
			continue
		end

		local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
		if not root then
			hideAll(o)
			continue
		end

		local rootPart = root :: BasePart
		local dist = (Camera.CFrame.Position - rootPart.Position).Magnitude

		if dist > CFG.ESP.MaxDist then
			hideAll(o)
			continue
		end

		local head = char:FindFirstChild("Head") or root
		local headPart = head :: BasePart

		local topPos = headPart.Position + Vector3.new(0, 0.6, 0)
		local bottomPos = rootPart.Position - Vector3.new(0, 2.8, 0)

		local top, topOn = Camera:WorldToViewportPoint(topPos)
		local bot, botOn = Camera:WorldToViewportPoint(bottomPos)

		if not (topOn and botOn) then
			hideAll(o)
			continue
		end

		local height = math.abs(bot.Y - top.Y)
		local width = height * 0.55
		local x = top.X - width / 2
		local y = math.min(top.Y, bot.Y)

		if CFG.ESP.Box then
			o.Box.Position = Vector2.new(x, y)
			o.Box.Size = Vector2.new(width, height)
			o.Box.Color = CFG.ESP.Color
			o.Box.Visible = true

			o.Outline.Position = Vector2.new(x, y)
			o.Outline.Size = Vector2.new(width, height)
			o.Outline.Visible = true
		else
			o.Box.Visible = false
			o.Outline.Visible = false
		end

		if CFG.ESP.Health then
			local frac = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
			local barX = x - 5
			o.HealthBg.Position = Vector2.new(barX, y)
			o.HealthBg.Size = Vector2.new(3, height)
			o.HealthBg.Visible = true

			o.Health.Position = Vector2.new(barX, y + height * (1 - frac))
			o.Health.Size = Vector2.new(3, height * frac)
			o.Health.Color = Color3.fromRGB(255 * (1 - frac), 255 * frac, 60)
			o.Health.Visible = true
		else
			o.HealthBg.Visible = false
			o.Health.Visible = false
		end

		if CFG.ESP.Name then
			o.Name.Position = Vector2.new(top.X, y - 15)
			o.Name.Text = plr.DisplayName
			o.Name.Visible = true
		else
			o.Name.Visible = false
		end

		if CFG.ESP.Distance then
			o.Dist.Position = Vector2.new(top.X, y + height + 3)
			o.Dist.Text = ("
