local canto = Instance.new("UICorner")
canto.CornerRadius = UDim.new(0,8)
canto.Parent = btn

btn.MouseButton1Down:Connect(function() aim = true end)
btn.MouseButton1Up:Connect(function() aim = false end)
btn.TouchLongPress:Connect(function() end)

local espBtn = btn:Clone()
espBtn.Position = UDim2.new(0,20,0.5,52)
espBtn.Text = "ESP ON"
espBtn.Parent = gui
espBtn.MouseButton1Click:Connect(function()
  CFG.Esp = not CFG.Esp
  espBtn.Text = CFG.Esp and "ESP ON" or "ESP OFF"
  fovCircle.Visible = CFG.Esp
end)

