function UnityBridge.GetPlayer()
    return { position = Vec3.new(0, 0, 0) }
end

function UnityBridge.GetEnemies()
    -- Cache enemies to reduce memory read frequency (Anti-pattern detection)
    if not UnityBridge._cache_enemies or (os.clock() - UnityBridge._cache_time > 1) then
        UnityBridge._cache_time = os.clock()
        UnityBridge._cache_enemies = {
            {name="Enemy_01", position=Vec3.new(10, 0, 20), health=100, maxHealth=100, isDead=false},
            {name="Enemy_02", position=Vec3.new(-5, 0, 15), health=50, maxHealth=100, isDead=false},
            {name="Boss", position=Vec3.new(0, 0, 50), health=200, maxHealth=500, isDead=false}
        }
    end
    return UnityBridge._cache_enemies
end

function UnityBridge.SetCameraRotation(newRotation)
    -- Apply final humanization before writing
    if CONFIG.stealth.enabled then
        newRotation.y = Stealth.Humanize(newRotation.y, CONFIG.stealth.jitterAmount, "yaw")
        newRotation.x = Stealth.Humanize(newRotation.x, CONFIG.stealth.jitterAmount, "pitch")
    end
    
    if CONFIG.debugMode then
        print(string.format("[Stealth] Aim Written: Y=%.4f X=%.4f", newRotation.y, newRotation.x))
    end
end

function UnityBridge.DrawESP(target, isTarget, screenPos)
    if not CONFIG.espEnabled then return end
    local color = isTarget and CONFIG.targetColor or CONFIG.espColor
    local dist = string.format("%.1f", target.distanceToPlayer or 0)
    
    if CONFIG.debugMode then
        local status = isTarget and "[TARGET]" or "[ESP]"
        print(string.format("%s %s | Dist: %sm | HP: %d/%d | Screen: (%d, %d)", 
            status, target.name, dist, target.health, target.maxHealth, 
            math.floor(screenPos.x), math.floor(screenPos.y)))
    end
end

-- ==========================================
-- CORE LOGIC
-- ==========================================
local CheatSystem = {}
local lastUpdate = 0
local currentTarget = nil
local currentTick = CONFIG.stealth.baseTickRate

function CheatSystem.Start()
    UnityBridge.Init()
    print("[Cheat] System Loaded with StealthCore.")
    print(string.format("[Cheat] Aimbot: %s | FOV: %.1f° | Stealth: %s", 
        tostring(CONFIG.aimbotEnabled), CONFIG.fov, tostring(CONFIG.stealth.enabled)))
end

function CheatSystem.Update()
    local now = os.clock()
    
    -- Dynamic Tick Rate
    if (now - lastUpdate) < currentTick then return end
    lastUpdate = now
    
    -- Update Tick Rate for next frame (Humanize timing)
    currentTick = Stealth.GetCurrentTick()

    local camera = UnityBridge.GetMainCamera()
    local player = UnityBridge.GetPlayer()
    local enemies = UnityBridge.GetEnemies()
    
    -- Get Dynamic FOV
    local activeFov = Stealth.GetDynamicFOV(CONFIG.fov)

    -- 1. Find Best Target
    local bestTarget = nil
    local closestAngle = activeFov
    local camPos = camera.position
    local camFwd = camera.forward

    for _, enemy in ipairs(enemies) do
        if not enemy.isDead then
            local toTarget = enemy.position - camPos
            local dist = toTarget:magnitude()
            
            if dist <= CONFIG.maxDistance and dist > 0 then
                local dirNorm = toTarget:normalized()
                local dot = camFwd:dot(dirNorm)
                local angle = math.deg(math.acos(math.min(1, math.max(-1, dot))))
                
                if angle < closestAngle then
                    closestAngle = angle
                    bestTarget = enemy
                end
            end
        end
    end

    currentTarget = bestTarget

    -- 2. Execute Aimbot
    if CONFIG.aimbotEnabled and currentTarget then
        local targetPos = currentTarget.position
        if CONFIG.bone == "head" then
            targetPos = targetPos + Vec3.new(0, 1.5, 0)
        elseif CONFIG.bone == "body" then
            targetPos = targetPos + Vec3.new(0, 1.0, 0)
        end

        local dir = (targetPos - camPos):normalized()
        
        local targetYaw = math.atan2(dir.x, dir.z)
        local targetPitch = -math.asin(dir.y)
        
        targetYaw = math.rad(targetYaw)
        targetPitch = math.rad(targetPitch)

        local currentYaw = math.rad(camera.rotation.y or 0)
        local currentPitch = math.rad(camera.rotation.x or 0)
        
        -- Smooth Interpolation
        local lerpFactor = 1 - math.pow(1 - CONFIG.smoothness, 10 * currentTick)
        
        local newYaw = currentYaw + (targetYaw - currentYaw) * lerpFactor * CONFIG.aimStrength
        local newPitch = currentPitch + (targetPitch - currentPitch) * lerpFactor * CONFIG.aimStrength
        
        newYaw = newYaw % (2 * math.pi)
        newPitch = math.max(-math.pi/2, math.min(math.pi/2, newPitch))

        -- Apply with Stealth Layer
        UnityBridge.SetCameraRotation({
            x = math.deg(newPitch),
            y = math.deg(newYaw),
            z = 0,
            w = 1
        })
    end

    -- 3. ESP Processing
    if CONFIG.espEnabled then
        for _, enemy in ipairs(enemies) do
            if not enemy.isDead then
                local screenPos = CheatSystem.WorldToScreen(enemy.position, camera)
                if screenPos and screenPos.z > 0 then
                    local isTarget = (enemy == currentTarget)
                    UnityBridge.DrawESP(enemy, isTarget, screenPos)
                end
            end
        end
    end
end

function CheatSystem.WorldToScreen(worldPos, camera)
    local camPos = camera.position
    local toPoint = worldPos - camPos
    local dist = toPoint:magnitude()
    
    local fovY = math.rad(60)
    local aspect = 16/9
    local fovX = 2 * math.atan(math.tan(fovY/2) * aspect)
    
    local angleX = math.atan2(toPoint.x, toPoint.z)
    local angleY = math.asin(toPoint.y / dist)
    
    local screenX = 0.5 + (angleX / fovX) * 0.5
    local screenY = 0.5 - (angleY / fovY) * 0.5
    
    return {
        x = screenX * 1920,
        y = screenY * 1080,
        z = dist
    }
end

