--// ===== CONFIG =====
local CFG = {
  FOV       = 140,     -- raio do FOV em pixels
  Smooth    = 0.30,    -- 0 = trava na hora, 1 = bem suave
  TeamCheck = true,    -- ignora aliado
  Esp       = true,    -- caixas
  Key       = Enum.KeyCode.E,
}

local Players   = game:GetService("Players")
local Run       = game:GetService("RunService")
local UIS       = game:GetService("UserInputService")
local LP        = Players.LocalPlayer
local Cam       = workspace.CurrentCamera
local V2        = Vector2.new

local aim, alvo, desenhos = false, nil, {}

--// ===== FOV =====
local fovCircle = Drawing.new("Circle")
fovCircle.Radius    = CFG.FOV
fovCircle.Thickness = 1
fovCircle.Color     = Color3.fromRGB(0,255,140)
fovCircle.Filled    = false
fovCircle.Visible   = true

Run.RenderStepped:Connect(function()
  local vp = Cam.ViewportSize
  fovCircle.Position = V2(vp.X/2, vp.Y/2)
end)

--// ===== ESP =====
local function criarEsp(plr)
  if plr == LP then return end
  local d = {
    box  = Drawing.new("Square"),
    nome = Drawing.new("Text"),
    dist = Drawing.new("Text"),
  }
  d.box.Thickness = 1
  d.box.Filled    = false
  d.box.Color     = Color3.fromRGB(0,255,140)
  d.nome.Size     = 14
  d.nome.Center   = true
  d.nome.Outline  = true
  d.nome.Color    = Color3.fromRGB(255,255,255)
  d.dist.Size     = 12
  d.dist.Center   = true
  d.dist.Outline  = true
  d.dist.Color    = Color3.fromRGB(255,210,80)
  desenhos[plr] = d
end

local function limparEsp(plr)
  local d = desenhos[plr]
  if not d then return end
  for _, v in pairs(d) do v:Remove() end
  desenhos[plr] = nil
end

for _, p in pairs(Players:GetPlayers()) do criarEsp(p) end
Players.PlayerAdded:Connect(criarEsp)
Players.PlayerRemoving:Connect(limparEsp)

Run.RenderStepped:Connect(function()
  for plr, d in pairs(desenhos) do
    local char = plr.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    local head = char and char:FindFirstChild("Head")
    local ok = CFG.Esp and hum and head and hum.Health > 0

    if CFG.TeamCheck and plr.Team == LP.Team then ok = false end

    if ok then
      local pos, onScreen = Cam:WorldToViewportPoint(head.Position)
      if onScreen then
        local alt = math.clamp(1400 / pos.Z, 18, 300)
        local topo = V2(pos.X - alt/4, pos.Y - alt/2)
        d.box.Size     = V2(alt/2, alt)
        d.box.Position = topo
        d.box.Visible  = true

        d.nome.Text     = plr.Name
        d.nome.Position = V2(pos.X, pos.Y - alt/2 - 16)
        d.nome.Visible  = true

        d.dist.Text     = math.floor(pos.Z) .. "m"
        d.dist.Position = V2(pos.X, pos.Y + alt/2 + 2)
        d.dist.Visible  = true
      else
        d.box.Visible, d.nome.Visible, d.dist.Visible = false, false, false
      end
    else
      d.box.Visible, d.nome.Visible, d.dist.Visible = false, false, false
    end
  end
end)

--// ===== AIMBOT =====
local function melhorAlvo()
  local vp  = Cam.ViewportSize
  local cen = V2(vp.X/2, vp.Y/2)
  local best, bestD = nil, CFG.FOV/2

  for _, plr in pairs(Players:GetPlayers()) do
    if plr ~= LP then
      local char = plr.Character
      local hum  = char and char:FindFirstChildOfClass("Humanoid")
      local head = char and char:FindFirstChild("Head")
      if hum and head and hum.Health > 0 then
        if not (CFG.TeamCheck and plr.Team == LP.Team) then
          local pos, on = Cam:WorldToViewportPoint(head.Position)
          if on then
            local d = (V2(pos.X, pos.Y) - cen).Magnitude
            if d < bestD then best, bestD = head, d end
          end
        end
      end
    end
  end
  return best
end

Run.RenderStepped:Connect(function()
  if not aim then return end
  alvo = melhorAlvo()
  if alvo then
    Cam.CFrame = Cam.CFrame:Lerp(
      CFrame.new(Cam.CFrame.Position, alvo.Position), CFG.Smooth
    )
  end
end)

UIS.InputBegan:Connect(function(k)
  if k.KeyCode == CFG.Key then aim = true end
end)
UIS.InputEnded:Connect(function(k)
  if k.KeyCode == CFG.Key then aim = false end
end)

--// ===== BOTÃO MOBILE =====
local gui = Instance.new("ScreenGui")
gui.Name = "sx"; gui.ResetOnSpawn = false
gui.Parent = game:GetService("CoreGui")

local btn = Instance.new("TextButton")
btn.Size = UDim2.new(0,110,0,42)
btn.Position = UDim2.new(0,20,0.5,0)
btn.BackgroundColor3 = Color3.fromRGB(18,18,22)
btn.TextColor3 = Color3.fromRGB(0,255,140)
btn.Font = Enum.Font.GothamBold
btn.TextSize = 14
