-- ================================
-- FUNÇÕES UTILITÁRIAS
-- ================================

-- Interpolação suave
local function lerp(start, finish, alpha)
    return start + (finish - start) * alpha
end

-- Calcula a distância angular entre dois vetores
local function angularDistance(a, b)
    local dot = a:Dot(b)
    return math.acos(math.clamp(dot, -1, 1))
end

-- Verifica se um alvo está dentro do FOV
local function isInFOV(targetPosition)
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    local cameraCFrame = Camera.CFrame
    local targetCFrame = CFrame.new(targetPosition)
    
    local dot = cameraCFrame.LookVector:Dot((targetPosition - root.Position).Unit)
    local fovRad = math.rad(CONFIG.AIMBOT_FOV)
    
    return dot > math.cos(fovRad)
end

-- Encontra a parte ideal para mirar
local function getIdealTargetPart(character)
    local parts = CONFIG.AIMBOT_TARGET_PART
    local priority = {
        "HumanoidRootPart",
        "Head",
        "Torso",
        "UpperTorso"
    }
    
    for _, partName in ipairs(priority) do
        local part = character:FindFirstChild(partName)
        if part then
            return part
        end
    end
    return character:FindFirstChild("HumanoidRootPart")
end

-- Calcula a posição prevista do alvo
local function predictTargetPosition(targetPart)
    if not targetPart then return nil end
    
    local velocity = targetPart.AssemblyLinearVelocity
    local predictedPos = targetPart.Position + (velocity * CONFIG.AIMBOT_PREDICTION)
    return predictedPos
end

-- ================================
-- SISTEMA DE ESP
-- ================================

local function createESP(player)
    if player == LocalPlayer then return end

    local function applyCharacter(character)
        if state.highlights[player] then
            state.highlights[player]:Destroy()
            state.highlights[player] = nil
        end

        if not state.espEnabled then return end

        local highlight = Instance.new("Highlight")
        highlight.Name = "RedESP"
        highlight.Adornee = character
        highlight.FillColor = CONFIG.ESP_COLOR
        highlight.FillTransparency = 1 - CONFIG.ESP_FILL_OPACITY
        highlight.OutlineColor = CONFIG.ESP_COLOR
        highlight.OutlineTransparency = 0
        highlight.OutlineLineThickness = CONFIG.ESP_LINE_WIDTH
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Enabled = true
        highlight.Parent = character

        state.highlights[player] = highlight
    end

    if player.Character then
        applyCharacter(player.Character)
    end

    player.CharacterAdded:Connect(applyCharacter)
    player.CharacterRemoving:Connect(function()
        if state.highlights[player] then
            state.highlights[player]:Destroy()
            state.highlights[player] = nil
        end
    end)
end

local function updateESP(player)
    if not state.espEnabled then
        if state.highlights[player] then
            state.highlights[player]:Destroy()
            state.highlights[player] = nil
        end
        return
    end

    if not player.Character then return end

    if not state.highlights[player] then
        createESP(player)
        return
    end

    local highlight = state.highlights[player]
    if not highlight or not highlight.Parent then return end

    -- Verifica distância
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local targetPos = player.Character:FindFirstChild("HumanoidRootPart")
    if not targetPos then return end

    local distance = (root.Position - targetPos.Position).Magnitude
    if distance > CONFIG.ESP_MAX_DISTANCE then
        highlight.Enabled = false
    else
        highlight.Enabled = true
    end
end

-- ================================
-- SISTEMA DE AIMBOT
-- ================================

local function findBestTarget()
    local bestTarget = nil
    local bestDistance = math.huge

    for _, otherPlayer in ipairs(Players:GetPlayers()) do
        if otherPlayer ~= LocalPlayer and otherPlayer.Character then
            local humanoid = otherPlayer.Character:FindFirstChild("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local targetPart = getIdealTargetPart(otherPlayer.Character)
                if targetPart then
                    local targetPos = predictTargetPosition(targetPart)
                    if targetPos and isInFOV(targetPos) then
                        local root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                        if root then
                            local distance = (root.Position - targetPos).Magnitude
                            if distance < CONFIG.AIMBOT_MAX_DISTANCE and distance < bestDistance then
                                bestDistance = distance
                                bestTarget = otherPlayer.Character
                            end
                        end
                    end
                end
            end
        end
    end
    return bestTarget
end

local function updateAimbot()
    if not state.aimbotEnabled then
        if state.lineAttachment then
            state.lineAttachment:Destroy()
            state.lineAttachment = nil
        end
        state.target = nil
        return
    end

    local character = LocalPlayer.Character
    if not character then return end

    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    -- Encontra o melhor alvo
    local bestTarget = findBestTarget()
    state.target = bestTarget

    if bestTarget then
        local targetPart = getIdealTargetPart(bestTarget)
        if targetPart then
            local targetPos = predictTargetPosition(targetPart)
            if targetPos then
                -- Calcula o ângulo ideal
                local idealCFrame = CFrame.new(root.Position, targetPos)
                local currentCFrame = Camera.CFrame
                
                -- Interpolação suave com ruído anti-ban
                local smoothing = CONFIG.AIMBOT_SMOOTHING
                if CONFIG.ANTI_BAN_OBFUSCATION then
                    smoothing = smoothing + (math.random() * 0.02 - 0.01) -- Adiciona ruído
                end

                local newCFrame = CFrame.Lerp(currentCFrame, idealCFrame, smoothing)
                
                -- Aplica à câmera (em um jogo real, você controlaria o mouse)
                Camera.CFrame = newCFrame

                -- Atualiza a linha de visão
                if CONFIG.AIMBOT_LINE_ENABLED then
                    if not state.lineAttachment then
                        state.lineAttachment = Instance.new("Part")
                        state.lineAttachment.Anchored = true
                        state.lineAttachment.CanQuery = false
                        state.lineAttachment.CanCollide = false
                        state.lineAttachment.Material = Enum.Material.Neon
                        state.lineAttachment.Color = CONFIG.AIMBOT_LINE_COLOR
                        state.lineAttachment.Size = Vector3.new(0.1, 0.1, 0.1)
                        state.lineAttachment.Transparency = 1
                        state.lineAttachment.Parent = Workspace
                    end

                    local midPoint = (root.Position + targetPos) / 2
                    local distance = (root.Position - targetPos).Magnitude
                    state.lineAttachment.CFrame = CFrame.new(midPoint, targetPos)
                    state.lineAttachment.Size = Vector3.new(0.1, 0.1, distance)
                end
            end
        end
    else
        -- Remove a linha se não houver alvo
        if state.lineAttachment then
            state.lineAttachment:Destroy()
            state.lineAttachment = nil
        end
    end
end

-- ================================
-- SISTEMA ANTI-AFK / ANTI-BAN
-- ================================

local function startAntiAFK()
    RunService.Heartbeat:Connect(function()
        local currentTime = tick()
        if currentTime - state.lastInputTime > CONFIG.ANTI_AFK_THRESHOLD then
            -- Simula um pequeno movimento do mouse
            local jitterX = math.random(-CONFIG.ANTI_AFK_JITTER, CONFIG.ANTI_AFK_JITTER)
            local jitterY = math.random(-CONFIG.ANTI_AFK_JITTER, CONFIG.ANTI_AFK_JITTER)
            UserInputService:SendMouseInput(Vector2.new(jitterX, jitterY))
            state.lastInputTime = currentTime
        end
    end)
end

