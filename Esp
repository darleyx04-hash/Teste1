--==========================================
-- SISTEMA DE LICENÇA
--==========================================
local Licenca = {
    ValidarKey = function(key)
        if not key or type(key) ~= "string" then
            return false, "Key inválida"
        end
        
        key = string.upper(string.gsub(key, "%s+", ""))
        
        if key == Config.KeyOficial then
            Estado.KeyValidada = true
            Estado.DiasRestantes = Config.DiasValidade
            return true, "Key 7 ativada com sucesso!"
        end
        
        return false, "Key inválida ou expirada"
    end,
    
    VerificarStatus = function()
        if Estado.KeyValidada then
            return string.format("Key 7 válida | %d dias restantes", Estado.DiasRestantes)
        else
            return "Key não validada"
        end
    end
}

--==========================================
-- SISTEMA DE ESQUENTAR (30 SEGUNDOS)
--==========================================
local Aquecimento = {
    Iniciar = function()
        if not Estado.Esquentado then
            Estado.Esquentando = true
            Estado.TimerEsquentar = Config.TempoEsquentar
            print("[CUE7A] Iniciando aquecimento de 30 segundos...")
            return true
        end
        return false
    end,
    
    Atualizar = function()
        if Estado.Esquentando then
            Estado.TimerEsquentar = Estado.TimerEsquentar - 1
            
            if Estado.TimerEsquentar % 5 == 0 and Estado.TimerEsquentar > 0 then
                print(string.format("[CUE7A] Aquecendo... %d segundos restantes", Estado.TimerEsquentar))
            end
            
            if Estado.TimerEsquentar <= 0 then
                Estado.Esquentando = false
                Estado.Esquentado = true
                print("[CUE7A] Sistema totalmente aquecido!")
                
                Estado.Aimbot.Ativo = true
                Estado.ESP.Ativo = true
                print("[CUE7A] Aimbot ativado")
                print("[CUE7A] ESP ativado (Círculo, Box, Linha)")
                return true
            end
        end
        return false
    end,
    
    Status = function()
        if Estado.Esquentando then
            return string.format("AQUECENDO: %d/%ds", Estado.TimerEsquentar, Config.TempoEsquentar)
        elseif Estado.Esquentado then
            return "PRONTO - SISTEMAS ATIVADOS"
        else
            return "AGUARDANDO INICIALIZAÇÃO (F2 para iniciar)"
        end
    end
}

--==========================================
-- SISTEMA DE AIMBOT
--==========================================
local AimbotSystem = {
    ObterAlvo = function()
        local melhorAlvo = nil
        local menorDistancia = Estado.Aimbot.FOV
        
        local camera = Workspace.CurrentCamera
        local centroTela = camera.ViewportSize / 2
        
        for _, jogador in ipairs(Players:GetPlayers()) do
            if jogador ~= LocalPlayer and jogador.Character then
                local personagem = jogador.Character
                local cabeca = personagem:FindFirstChild("Head")
                
                if cabeca then
                    local posicao3D, naTela = camera:WorldToViewportPoint(cabeca.Position)
                    
                    if naTela then
                        local distancia = (Vector2.new(posicao3D.X, posicao3D.Y) - centroTela).Magnitude
                        
                        if distancia < menorDistancia then
                            menorDistancia = distancia
                            melhorAlvo = cabeca
                        end
                    end
                end
            end
        end
        
        return melhorAlvo
    end,
    
    AplicarAimbot = function()
        if not Estado.Aimbot.Ativo or not Estado.Esquentado then return end
        
        local alvo = AimbotSystem.ObterAlvo()
        
        if alvo then
            local camera = Workspace.CurrentCamera
            local posicaoAlvo = alvo.Position
            
            -- Suavizar movimento
            local currentCFrame = camera.CFrame
            local targetCFrame = CFrame.new(currentCFrame.Position, posicaoAlvo)
            
            -- Interpolação suave
            local smoothFactor = Estado.Aimbot.Smooth / 10
            camera.CFrame = currentCFrame:Lerp(targetCFrame, 1 / smoothFactor)
        end
    end
}

--==========================================
-- SISTEMA DE ESP (DESENHO NA TELA)
--==========================================
local ESPSystem = {
    -- Criar Drawing para ESP (Luau suporta Drawing API)
    Circulos = {},
    Boxes = {},
    Linhas = {},
    
    CriarCirculo = function()
        local circle = Drawing.new("Circle")
        circle.Visible = false
        circle.Color = Estado.ESP.Circulo.Cor
        circle.Thickness = Estado.ESP.Circulo.Espessura
        circle.Radius = Estado.ESP.Circulo.Raio
        circle.Filled = false
        return circle
    end,
    
    CriarBox = function()
        local box = Drawing.new("Square")
        box.Visible = false
        box.Color = Estado.ESP.Box.Cor
        box.Thickness = Estado.ESP.Box.Espessura
        box.Filled = false
        return box
    end,
    
    CriarLinha = function()
        local line = Drawing.new("Line")
        line.Visible = false
        line.Color = Estado.ESP.Linha.Cor
        line.Thickness = Estado.ESP.Linha.Espessura
        return line
    end,
    
    Renderizar = function()
        if not Estado.ESP.Ativo or not Estado.Esquentado then return end
        
        local camera = Workspace.CurrentCamera
        local screenSize = camera.ViewportSize
        local centroTela = screenSize / 2
        
        -- Limpar ESPs antigos
        for _, esp in pairs(ESPSystem.Circulos) do esp:Remove() end
        for _, esp in pairs(ESPSystem.Boxes) do esp:Remove() end
        for _, esp in pairs(ESPSystem.Linhas) do esp:Remove() end
        ESPSystem.Circulos = {}
        ESPSystem.Boxes = {}
        ESPSystem.Linhas = {}
        
        -- Iterar sobre jogadores
        for _, jogador in ipairs(Players:GetPlayers()) do
            if jogador ~= LocalPlayer and jogador.Character then
                local personagem = jogador.Character
                local cabeca = personagem:FindFirstChild("Head")
                local humanoidRootPart = personagem:FindFirstChild("HumanoidRootPart")
                local humanoid = personagem:FindFirstChild("Humanoid")
                
                if cabeca and humanoidRootPart and humanoid and humanoid.Health > 0 then
                    local distancia = (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and 
                                      (humanoidRootPart.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude) or 0
                    
                    if distancia <= Estado.ESP.DistanciaMax then
                        local posicao3D, naTela = camera:WorldToViewportPoint(humanoidRootPart.Position)
                        
                        if naTela then
                            local posicaoTela = Vector2.new(posicao3D.X, posicao3D.Y)
                            
                            -- Desenhar Círculo Verde
                            if Estado.ESP.Circulo.Ativo then
                                local circle = ESPSystem.CriarCirculo()
                                circle.Position = posicaoTela
                                circle.Visible = true
                                table.insert(ESPSystem.Circulos, circle)
                            end
                            
                            -- Desenhar Box
                            if Estado.ESP.Box.Ativo then
                                local box = ESPSystem.CriarBox()
                                local tamanhoBox = Vector2.new(40, 80)
                                box.Size = tamanhoBox
                                box.Position = posicaoTela - tamanhoBox / 2
                                box.Visible = true
                                table.insert(ESPSystem.Boxes, box)
                            end
                            
                            -- Desenhar Linha
                            if Estado.ESP.Linha.Ativo then
                                local line = ESPSystem.CriarLinha()
                                line.From = centroTela
                                line.To = posicaoTela
                                line.Visible = true
                                table.insert(ESPSystem.Linhas, line)
                            end
                        end
                    end
                end
            end
        end
    end
}

