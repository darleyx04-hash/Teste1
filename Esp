		Font = Enum.Font.GothamBold,
		Text = label,
		TextSize = 12,
		TextColor3 = Theme.Text,
		AutoButtonColor = false,
		Parent = parent,
	})
	round(btn, 6)
	stroke(btn, Theme.Stroke, 1)
	btn.MouseButton1Click:Connect(callback)
	return btn
end

